DEV_MODE=true

# Logging
LOG_LEVEL=info

BOT_TIMEZONE="Asia/Kolkata"

# Mongdb
MONGO_URI=

# WhatsApp Bot Phone Number (with country code, no + or spaces)
PHONE_NUMBER=91XXXXXXXXXX

# WireGuard Server SSH Access
WG_SSH_HOST=your-wg-server-ip
WG_SSH_PORT=22
WG_SSH_USER=root
WG_SSH_KEY_PATH=/path/to/ssh/private/key
WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
WG_SERVER_ENDPOINT=your-wg-server-ip:51820
WG_DNS=1.1.1.1,1.0.0.1
WG_ALLOWED_IPS=0.0.0.0/0
WG_SUBNET=10.0.0

# AI Provider (none | gemini | openai | claude | ollama)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_HISTORY_EXPIRATION_DAYS=3
AI_HISTORY_MAX_MESSAGES=30
AI_MEMORY_MAX_PER_USER=50
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_RPM_LIMIT=15

# Jenkins Integration
JENKINS_ENABLED=false
JENKINS_PORT=3000
WEBHOOK_BASE_URL=https://your-bot-public-url.com
JENKINS_SERVER_URL=http://your-jenkins-server-ip:8080

EXTERNAL_SERVERS_JSON='[{"name": "", "url": "", "apiKey": ""}, {"name": "", "url": "", "apiKey": ""}]'
PING_SITES_JSON='[{"name": "", "url": ""}]'
