{
  "name": "hana-bot",
  "version": "0.0.6",
  "description": "WhatsApp bot for server monitoring, WireGuard VPN management, and AI chat",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "wireguard",
    "monitoring"
  ],
  "license": "MIT",
  "dependencies": {
    "@cacheable/node-cache": "^3.1.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "exiftool-vendored": "^35.21.0",
    "express": "^5.2.1",
    "link-preview-js": "^3.2.0",
    "mongoose": "^9.10.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.4",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.12",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ssh2": "^1.15.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@whiskeysockets/baileys": true,
    "ssh2": true,
    "protobufjs": true,
    "cpu-features": true,
    "esbuild": true
  }
}
